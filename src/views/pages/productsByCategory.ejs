
<section class="products-grid">
    <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
            <article class="product-card">
                <a href="/product/<%= product.id %>" class="product-link">
                    <div class="product-image">
                        <img src="<%= product.image || '/img/placeholder.png' %>" alt="<%= product.name %>">
                    </div>
                    <div class="product-info">
                        <h3 class="product-name"><%= product.name %></h3>
                        <p class="product-category"><%= product.category %></p>
                    </div>
                </a>

                <div class="product-footer">
                    <span class="product-price"><%= Number(product.price).toFixed(2) %>€</span>
                    <%# data-cart-add + data-product-* es el contrato con cart-sidebar.js para añadir al carrito guest %>
                    <button
                        type="button"
                        class="add-to-cart-btn"
                        data-cart-add
                        data-product-id="<%= product.id %>"
                        data-product-name="<%= product.name %>"
                        data-product-price="<%= Number(product.price) %>"
                        data-product-image="<%= product.image || '/img/placeholder.png' %>"
                    >
                        Añadir
                    </button>
                </div>
            </article>
        <% }) %>
    <% } else { %>
        <p>No hay productos disponibles en este momento.</p>
    <% } %>
</section>
