<div class="dashboard-header">
    <div class="header-title">
        <h1>Editar Usuario</h1>
        <p class="header-subtitle">Modificando perfil de: <strong>
                <%= user.name %>
                    <%= user.surname %>
            </strong></p>
    </div>
    <a href="/admin/user" class="btn btn-secondary">← Volver</a>
</div>

<div class="card card-form">
    <form action="/admin/user/<%= user.dni %>" method="POST">
        <div class="form-section">
            <div class="section-title"><span class="step-number">1</span>Información Personal</div>
            <div class="form-grid">
                <div class="form-group"><label>Nombre</label><input type="text" name="name" value="<%= user.name %>">
                </div>
                <div class="form-group"><label>Apellido</label><input type="text" name="surname"
                        value="<%= user.surname %>"></div>
                <div class="form-group readonly-group"><label>DNI (No editable)</label><input type="text" name="dni"
                        value="<%= user.dni %>" readonly></div>
                <div class="form-group"><label>Email</label><input type="email" name="email" value="<%= user.email %>">
                </div>
                <div class="form-group"><label>Teléfono</label><input type="text" name="phone"
                        value="<%= user.phone %>"></div>
                <div class="form-group"><label>Dirección</label><input type="text" name="address"
                        value="<%= user.address %>"></div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-title"><span class="step-number">2</span>Cuenta y Seguridad</div>
            <div class="form-grid">
                <div class="form-group"><label>Username</label><input type="text" name="username"
                        value="<%= user.username %>" required></div>
                <div class="form-group"><label>Contraseña</label><input type="password" name="password"
                        placeholder="Dejar en blanco para no cambiar"></div>
                <div class="form-group">
                    <label>Tipo de Usuario</label>
                    <select name="type" class="custom-select">
                        <option value="cliente" <%=user.type==='cliente' ? 'selected' : '' %>>Cliente</option>
                        <option value="admin" <%=user.type==='admin' ? 'selected' : '' %>>Administrador</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-title"><span class="step-number">3</span>Facturación</div>
            <div class="form-grid">
                <div class="form-group"><label>Número tarjeta</label><input type="text" name="card_number"
                        value="<%= user.card_number %>"></div>
                <div class="form-group">
                    <label>Fecha de caducidad</label>
                    <input type="date" name="valid_date"
                        value="<%= user.valid_date ? new Date(user.valid_date).toISOString().split('T')[0] : '' %>">
                </div>
                <div class="form-group"><label>CVV</label><input type="number" name="cvv" value="<%= user.cvv %>"></div>
            </div>
        </div>

        <div class="form-footer">
            <p class="form-disclaimer">Verifique la información antes de guardar cambios.</p>
            <button type="submit" class="btn btn-primary btn-large">Guardar Cambios</button>
        </div>
    </form>
</div>