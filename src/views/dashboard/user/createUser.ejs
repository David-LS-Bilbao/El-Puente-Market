<div class="dashboard-header">
    <h1>Crear Nuevo Usuario</h1>
    <a href="/admin/user" class="btn btn-secondary">← Volver</a>
</div>

<div class="card card-form">
    <form action="/admin/user" method="POST">
        <div class="form-section">
            <div class="section-title"><span class="step-number">1</span>Información Personal</div>
            <div class="form-grid">
                <div class="form-group"><label>Nombre</label><input type="text" name="name" required
                        placeholder="Ej: Juan"></div>
                <div class="form-group"><label>Apellido</label><input type="text" name="surname" required
                        placeholder="Ej: Pérez"></div>
                <div class="form-group"><label>DNI</label><input type="text" name="dni" required
                        placeholder="12345678X"></div>
                <div class="form-group"><label>Email</label><input type="email" name="email"
                        placeholder="correo@ejemplo.com"></div>
                <div class="form-group"><label>Teléfono</label><input type="text" name="phone" required
                        placeholder="+34..."></div>
                <div class="form-group"><label>Dirección</label><input type="text" name="address" required
                        placeholder="Calle Falsa 123"></div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-title"><span class="step-number">2</span>Configuración de Cuenta</div>
            <div class="form-grid">
                <div class="form-group"><label>Username</label><input type="text" name="username" required></div>
                <div class="form-group"><label>Contraseña</label><input type="password" name="password" required
                        placeholder="••••••••"></div>
                <div class="form-group">
                    <label>Tipo de Usuario</label>
                    <select name="type" class="custom-select">
                        <option value="cliente">Cliente</option>
                        <option value="admin">Administrador</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-title"><span class="step-number">3</span>Datos de Facturación</div>
            <div class="form-grid">
                <div class="form-group"><label>Número tarjeta</label><input type="text" name="card_number" required
                        placeholder="0000 0000 0000 0000"></div>
                <div class="form-group"><label>Fecha de caducidad</label><input type="date" name="valid_date" required>
                </div>
                <div class="form-group"><label>CVV</label><input type="number" name="cvv" required placeholder="123">
                </div>
            </div>
        </div>

        <div class="form-footer">
            <button type="submit" class="btn btn-primary btn-large">Registrar Usuario</button>
        </div>
    </form>
</div>