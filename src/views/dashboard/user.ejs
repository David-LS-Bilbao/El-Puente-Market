<div class="dashboard-header">
    <h1>Usuarios</h1>

    <a href="/admin/user/create" class="btn btn-primary">
        + Crear usuario
    </a>
</div>

<div class="card">

    <table class="table">
        <thead>
            <tr>
                <th>DNI</th>
                <th>Usuario</th>
                <th>Email</th>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Tipo</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            <% users.forEach(user=> { %>
                <tr>
                    <td>
                        <a href="/admin/user/details/<%= user.dni %>">
                            <%= user.dni %>
                        </a>
                    </td>
                    <td>
                        <%= user.username %>
                    </td>
                    <td>
                        <%= user.email %>
                    </td>
                    <td>
                        <%= user.name %>
                            <%= user.surname %>
                    </td>
                    <td>
                        <%= user.phone %>
                    </td>
                    <td>
                        <%= user.type %>
                    </td>

                    <td>
                        <a href="/admin/user/edit/<%= user.dni %>" class="btn btn-warning">
                            Editar
                        </a>

                        <form action="/admin/user/delete/<%= user.dni %>" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-danger">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>

</div>