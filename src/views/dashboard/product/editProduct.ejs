<div class="dashboard-header">
    <div class="header-title">
        <h1>Editar Producto</h1>
        <p class="header-subtitle">Modificando: <strong>
                <%= product.name %>
            </strong></p>
    </div>
    <a href="/admin/product" class="btn btn-secondary">← Volver</a>
</div>

<div class="card card-form">
    <form action="/admin/product/<%= product.id %>" method="POST">

        <div class="form-section">
            <div class="section-title"><span class="step-number">1</span>Información General</div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Nombre del Producto</label>
                    <input type="text" name="name" value="<%= product.name %>" required>
                </div>
                <div class="form-group">
                    <label>Categoría</label>
                    <select name="id_category" class="custom-select" required>
                        <% categories.forEach(cat=> { %>
                            <option value="<%= cat.id %>" <%=product.id_category===cat.id ? 'selected' : '' %>>
                                <%= cat.name %>
                            </option>
                            <% }) %>
                    </select>
                </div>
                <div class="form-group" style="grid-column: span 2;">
                    <label>Descripción</label>
                    <textarea name="description" rows="3"><%= product.description %></textarea>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-title"><span class="step-number">2</span>Inventario y Visualización</div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Stock Disponible</label>
                    <input type="number" name="stock" value="<%= product.stock %>" required min="0">
                </div>
                <div class="form-group">
                    <label>URL de la Imagen</label>
                    <input type="text" name="image" value="<%= product.image %>">
                </div>
                <% if (product.image) { %>
                    <div class="form-group" style="grid-column: span 2;">
                        <label>Vista previa actual:</label>
                        <img src="<%= product.image %>"
                            style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd; display: block; margin-top: 5px;">
                    </div>
                    <% } %>
            </div>
        </div>

        <div class="form-section">
            <div class="section-title"><span class="step-number">3</span>Precios y Ofertas</div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Precio Original (€)</label>
                    <input type="number" step="0.01" name="price" value="<%= product.price %>" required>
                </div>
                <div class="form-group">
                    <label>¿En Oferta?</label>
                    <select name="on_discount" class="custom-select" id="discountToggle">
                        <option value="false" <%=!product.on_discount ? 'selected' : '' %>>No</option>
                        <option value="true" <%=product.on_discount ? 'selected' : '' %>>Sí, aplicar oferta</option>
                    </select>
                </div>
                <div class="form-group" id="discountPriceField">
                    <label>Precio Rebajado (€)</label>
                    <input type="number" step="0.01" name="price_discount" value="<%= product.price_discount %>">
                </div>
            </div>
        </div>

        <div class="form-footer">
            <p class="form-disclaimer">Los cambios se aplicarán inmediatamente en el catálogo público.</p>
            <button type="submit" class="btn btn-primary btn-large">Actualizar Producto</button>
        </div>
    </form>
</div>

<script>
    const toggle = document.getElementById('discountToggle');
    const field = document.getElementById('discountPriceField');

    const updateDiscountVisibility = () => {
        field.style.display = toggle.value === 'true' ? 'block' : 'none';
    };

    toggle.addEventListener('change', updateDiscountVisibility);

    updateDiscountVisibility();
</script>