<div class="dashboard-header">
    <div class="header-title">
        <h1>Editar Ítem del Carrito</h1>
        <p class="header-subtitle">Modificando pedido de: <strong>
                <%= cart.user_dni %>
            </strong></p>
    </div>
    <a href="/admin/cart" class="btn btn-secondary">← Volver</a>
</div>

<div class="card card-form">
    <!-- Ajusta la ruta según tu router: /admin/cart/update/:id -->
    <form action="/admin/cart/<%= cart.id %>" method="POST">
        <div class="form-section">
            <div class="section-title"><span class="step-number">1</span>Información del Pedido</div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Producto (ID: <%= cart.product_id %>)</label>
                    <input type="text" value="<%= cart.Product ? cart.Product.name : 'ID: ' + cart.product_id %>"
                        readonly style="background-color: #f8f9fa;">
                </div>
                <div class="form-group">
                    <label>Usuario (DNI)</label>
                    <input type="text" name="user_dni" value="<%= cart.user_dni %>" readonly
                        style="background-color: #f8f9fa;">
                </div>
                <div class="form-group">
                    <label>Cantidad</label>
                    <input type="number" name="quantity" value="<%= cart.quantity %>" min="1" required>
                </div>
                <div class="form-group">
                    <label>Monto Total (€)</label>
                    <input type="number" name="total_amount" value="<%= cart.total_amount %>" step="0.01" required>
                </div>
            </div>
        </div>

        <div class="form-footer">
            <button type="submit" class="btn btn-primary btn-large">Actualizar Carrito</button>
        </div>
    </form>
</div>