<div class="dashboard-header">
    <div class="header-title">
        <h1>Editar Categoría</h1>
        <p class="header-subtitle">Modificando: <strong>
                <%= category.name %>
            </strong></p>
    </div>
    <a href="/admin/category" class="btn btn-secondary">← Volver</a>
</div>

<div class="card card-form">
    <form action="/admin/category/<%= category.id %>" method="POST">
        <div class="form-section">
            <div class="section-title"><span class="step-number">1</span>Actualizar Información</div>
            <div class="form-grid">
                <div class="form-group">
                    <label>ID (No editable)</label>
                    <input type="text" value="#<%= category.id %>" readonly style="background-color: #f8f9fa;">
                </div>
                <div class="form-group">
                    <label>Nombre de la Categoría</label>
                    <input type="text" name="name" value="<%= category.name %>" required>
                </div>
            </div>
        </div>

        <div class="form-footer">
            <button type="submit" class="btn btn-primary btn-large">Guardar Cambios</button>
        </div>
    </form>
</div>
