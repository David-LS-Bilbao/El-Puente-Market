<% const cartData = typeof cartSidebar !== 'undefined' ? cartSidebar : {}; const items = cartData.items || []; const isEmpty = typeof cartData.isEmpty !== 'undefined' ? cartData.isEmpty : items.length === 0; const totalGeneralFormatted = cartData.totalGeneralFormatted || '0,00 €'; %>
<div class="cart-sidebar-shell" aria-hidden="true">
  <div class="cart-sidebar-shell__backdrop" data-cart-sidebar-close></div>
  <div class="cart-sidebar-shell__panel">
    <div class="cart-sidebar">
      <div class="cart-sidebar__header">
          <div>
              <p class="cart-sidebar__eyebrow">Carrito</p>
              <h2>Tu carrito</h2>
          </div>
          <button type="button" class="cart-sidebar__close" data-cart-sidebar-close aria-label="Cerrar carrito">
              ×
          </button>
      </div>

      <% if (isEmpty) { %>
        <section class="cart-sidebar__empty">
            <h3>Tu carrito está vacío</h3>
            <p>Añade productos para verlos reflejados aquí.</p>
            <button type="button" class="cart-link-btn" data-cart-sidebar-close>Seguir comprando</button>
        </section>
      <% } else { %>
        <div class="cart-sidebar__list" aria-label="Productos del carrito">
            <% items.forEach((item) => { %>
                <article class="cart-sidebar__item" data-item-id="<%= item.id %>" data-quantity="<%= item.quantity %>" data-subtotal="<%= item.subtotal %>">
                    <% if (item.productImage) { %>
                        <img src="<%= item.productImage %>" alt="<%= item.productName %>" class="cart-sidebar__image">
                    <% } else { %>
                        <div class="cart-sidebar__placeholder" aria-hidden="true">Sin imagen</div>
                    <% } %>

                    <div class="cart-sidebar__item-content">
                        <h3><%= item.productName %></h3>

                        <div class="cart-sidebar__qty-row">
                            <button type="button" class="cart-qty-btn" data-action="minus" aria-label="Disminuir cantidad">−</button>
                            <span class="cart-qty-value"><%= item.quantity %></span>
                            <button type="button" class="cart-qty-btn" data-action="plus" aria-label="Aumentar cantidad">+</button>
                            <button type="button" class="cart-delete-btn" data-action="delete" aria-label="Eliminar producto">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                                    <path d="M10 11v6"></path>
                                    <path d="M14 11v6"></path>
                                    <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                                </svg>
                            </button>
                        </div>

                        <p class="cart-sidebar__subtotal">Subtotal: <strong><%= item.subtotalFormatted %></strong></p>
                    </div>
                </article>
            <% }) %>
        </div>

        <div class="cart-sidebar__footer">
            <div class="cart-sidebar__total">
                <span>Total general</span>
                <strong data-cart-total><%= totalGeneralFormatted %></strong>
            </div>
            <button type="button" class="cart-link-btn" data-cart-sidebar-close>Seguir comprando</button>
            <a href="/checkout" class="cart-link-btn cart-link-btn--primary">Pagar</a>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const trigger = document.querySelector('[data-cart-sidebar-trigger]');
  const shell = document.querySelector('.cart-sidebar-shell');
  if (!trigger || !shell) return;

  const openSidebar = () => {
    shell.classList.add('cart-sidebar-shell--open');
    shell.setAttribute('aria-hidden', 'false');
  };

  const closeSidebar = () => {
    shell.classList.remove('cart-sidebar-shell--open');
    shell.setAttribute('aria-hidden', 'true');
  };

  trigger.addEventListener('click', (event) => {
    event.preventDefault();
    openSidebar();
  });

  shell.addEventListener('click', (event) => {
    if (event.target.closest('[data-cart-sidebar-close]')) {
      closeSidebar();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeSidebar();
    }
  });
});
</script>
