<header class="header">
    <% const currentUser = typeof user !== 'undefined' ? user : null; %>
    <% const profileHref = !currentUser ? '/auth/login' : currentUser.type === 'admin' ? '/admin' : '/'; %>

    <div class="header-top">

        <!-- IZQUIERDA: logo + título -->
        <div class="left">
            <a href="/"><img src="/img/logo.png" alt="Logo El Puente" class="logo"></a>
        </div>

        <!-- DERECHA: acciones -->
        <div class="right">
            <% if (currentUser) { %>
                <span class="user-sub-text">Hola, <%= currentUser.username %></span>
            <% } %>

            <!-- Carrito -->
            <a href="#" class="icon-btn" data-cart-sidebar-trigger
                data-cart-sidebar-user-dni="<%= currentUser?.dni || (typeof userDni !== 'undefined' ? userDni : '') %>"
                aria-label="Abrir carrito">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                    stroke="currentColor" class="icon">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                </svg>
            </a>

            <!-- Login -->
            <a href="<%= profileHref %>" class="icon-btn"
                title="<%= currentUser ? ('Sesión iniciada: ' + currentUser.username) : 'Iniciar sesión' %>">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                    stroke="currentColor" class="icon">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                </svg>

            </a>

            <% if (currentUser) { %>
                <form action="/auth/logout" method="POST" style="margin: 0;">
                    <button type="submit" class="icon-btn" title="Cerrar sesión" aria-label="Cerrar sesión"
                        style="background: none; border: none; padding: 0; cursor: pointer;">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="icon">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6A2.25 2.25 0 0 0 5.25 5.25v13.5A2.25 2.25 0 0 0 7.5 21h6A2.25 2.25 0 0 0 15.75 18.75V15m3 0 3-3m0 0-3-3m3 3H9" />
                        </svg>
                    </button>
                </form>
            <% } %>

        </div>

    </div>

</header>

<%- include('../partials/cart-sidebar') %>
