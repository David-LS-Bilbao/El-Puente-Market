<div class="login-container">
    <div class="card login-card">
        <div class="login-header">
            <h2 class="login-title">¡Bienvenido de nuevo!</h2>
            <p class="header-subtitle">Por favor, introduce tus credenciales</p>
        </div>

        <% if (locals.message) { %>
            <div class="login-error">
                <i class="error-icon">⚠️</i>
                <%= message %>
            </div>
            <% } %>

                <form action="/auth/login" method="POST" class="login-form">
                    <div class="form-group">
                        <label for="dni">DNI</label>
                        <input type="text" name="dni" id="dni" placeholder="12345678X" required value="12345678M">
                    </div>

                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <input type="password" name="password" id="password" placeholder="••••••••" value="123456"
                            required>
                    </div>

                    <button class="btn btn-primary btn-large btn-block" type="submit">
                        Entrar al panel
                    </button>
                </form>

                <div class="login-footer">
                    <p>¿No tienes una cuenta? <a href="/auth/register" class="user-link">Regístrate aquí</a></p>
                </div>
    </div>
</div>